# ===== 运行环境 =====
ENVIRONMENT=development
DEBUG=true

# JWT 签名密钥（生产环境务必替换：openssl rand -hex 32）
SECRET_KEY=please-generate-with-openssl-rand-hex-32-and-replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

# ===== MySQL 8.0 =====
# Docker Compose 中会覆盖为 mysql:3306；本地开发使用 127.0.0.1
DATABASE_URL=mysql+aiomysql://erp:erp_password@127.0.0.1:3306/agri_erp?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=300

# 看板统计时区
TIMEZONE=Asia/Shanghai

# 允许跨域来源，* 表示全部
CORS_ORIGINS=*

# 生产必须为 false，由 Alembic 管理表结构
AUTO_CREATE_TABLES=false

# 启动时校验数据库结构（缺表/缺列时直接启动失败，避免运行期 500）
SCHEMA_CHECK_ON_STARTUP=true

# ===== 初始化账号（仅 init_db 使用）=====
SEED_BOSS_USERNAME=admin
SEED_BOSS_PASSWORD=Boss@123456
SEED_EMPLOYEE_USERNAME=staff
SEED_EMPLOYEE_PASSWORD=Staff@123456
