# ===== 生产环境变量（复制为 deploy/.env 后填写，切勿入库）=====
# 生成密钥：openssl rand -hex 32

ENVIRONMENT=production
DEBUG=false

# JWT 签名密钥（必须替换）
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

# ===== MySQL（供 compose 创建容器用，DATABASE_URL 由 compose 自动拼装）=====
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=agri_erp
MYSQL_USER=erp
MYSQL_PASSWORD=change-me

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ===== Redis =====
CACHE_TTL_SECONDS=300

TIMEZONE=Asia/Shanghai

# 同源部署，前端与接口都在 https://agri.novix.ccwu.cc 下
CORS_ORIGINS=https://agri.novix.ccwu.cc

AUTO_CREATE_TABLES=false
SCHEMA_CHECK_ON_STARTUP=true

# ===== 初始化账号（首次启动自动创建，登录后请立刻改密码）=====
SEED_BOSS_USERNAME=admin
SEED_BOSS_PASSWORD=change-me-strong
