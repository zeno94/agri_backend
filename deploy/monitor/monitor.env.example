# 巡检脚本配置（复制为 monitor.env 后填写；不填也能跑，只是不发外部告警）

# 巡检对象
PUBLIC_URL=https://agri.novix.ccwu.cc
API_CONTAINER=agri-erp-api

# 告警阈值（百分比）
DISK_WARN_PCT=85
MEM_WARN_PCT=92

# ===== 告警通道（任选其一或都填；都留空则只写本地日志）=====

# 1) healthchecks.io：建一个 check 拿到 ping URL。
#    正常每 5 分钟 ping 一次；超过宽限期没收到 ping，它自己发邮件告警。
#    HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 2) 钉钉群机器人：群设置 → 智能群助手 → 添加机器人 → 自定义 → 复制 Webhook
#    DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
